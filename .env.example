# ===========================================
# Demo Auth Credentials
# ===========================================
DEMO_EMAIL=analyst@enfuce.demo
DEMO_PASSWORD=enfuce2026

# ===========================================
# Supabase (data storage)
# ===========================================
# Mock mode: leave NEXT_PUBLIC_SUPABASE_URL blank
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===========================================
# OpenRouter (AI / LLM)
# ===========================================
# Mock mode: leave OPENROUTER_API_KEY blank
OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_MODEL=anthropic/claude-sonnet-4

# ===========================================
# Bright Data (web search)
# ===========================================
# Optional: leave blank to skip web search
BRIGHTDATA_API_TOKEN=your-brightdata-token
BRIGHTDATA_ZONE=your-zone
